{
  "name": "nexus-bank-api",
  "version": "1.0.0",
  "private": true,
  "description": "NEXUS BANK - production-grade educational digital banking and wallet management API: double-entry ledger, rotating refresh tokens, TOTP 2FA, RBAC, idempotent financial APIs, signed payment webhooks (educational simulation, not a real bank)",
  "license": "MIT",
  "author": "AmrKhaled000",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmrKhaled000/nexus-bank-api.git"
  },
  "homepage": "https://github.com/AmrKhaled000/nexus-bank-api#readme",
  "bugs": {
    "url": "https://github.com/AmrKhaled000/nexus-bank-api/issues"
  },
  "keywords": [
    "banking",
    "fintech",
    "digital-banking",
    "wallet",
    "ledger",
    "double-entry",
    "nodejs",
    "typescript",
    "express",
    "prisma",
    "postgresql",
    "rest-api",
    "security",
    "rbac",
    "idempotent",
    "educational"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "worker": "node dist/workers/index.js",
    "worker:dev": "tsx watch src/workers/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.config.ts",
    "test:integration": "cross-env NODE_ENV=test vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "postman:export": "tsx scripts/export-postman.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.60.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.205.0",
    "@opentelemetry/sdk-node": "0.205.0",
    "@prisma/client": "6.19.3",
    "bullmq": "5.81.5",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "7.0.13",
    "otplib": "12.0.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "rate-limit-redis": "6.0.2",
    "stripe": "18.5.0",
    "swagger-ui-express": "5.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.10.1",
    "@types/nodemailer": "7.0.12",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "@vitest/coverage-v8": "3.2.7",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.7.4",
    "prisma": "6.19.3",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "3.2.7"
  }
}
